{
  "buildCommand": "cd webstudio-project/build && npm install",
  "outputDirectory": "webstudio-project/build/public",
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
